<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@theme.css"
            fx:controller="ca.seneca.hotel.controller.FeedbackController">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true">
            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="20"
                      maxWidth="800">

                    <padding>
                        <Insets top="30"
                                right="50"
                                bottom="30"
                                left="50"/>
                    </padding>

                    <!-- TITLE -->
                    <Label text="Guest Feedback"
                           styleClass="title-label"/>
                    <Label text="Feedback is only available after checkout. Please verify your booking to continue."
                           wrapText="true"
                           styleClass="muted-label"/>
                    <Separator/>

                    <!-- VERIFY BOOKING -->
                    <VBox spacing="10"
                          prefWidth="400">

                        <Label text="Reservation Number"/>
                        <TextField fx:id="bookingNumberField"
                                   promptText="Enter your reservation ID"/>

                        <Label text="Email Address"/>
                        <TextField fx:id="emailField"
                                   promptText="Enter email used for booking"/>

                        <Button text="Verify Booking"
                                onAction="#verifyBooking"
                                maxWidth="Infinity"
                                styleClass="button-primary"/>

                        <Label fx:id="messageLabel"
                               wrapText="true"/>
                    </VBox>
                    <Separator/>

                    <!-- FEEDBACK SECTION -->
                    <VBox fx:id="feedbackSection"
                          spacing="20"
                          visible="true"
                          managed="true"
                          prefWidth="600">

                        <Label text="Rate Your Stay"
                               styleClass="section-label"/>

                        <GridPane hgap="20"
                                  vgap="15">

                            <!-- OVERALL -->
                            <Label text="Overall Experience:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <HBox fx:id="overallStars"
                                  spacing="5"
                                  GridPane.rowIndex="0"
                                  GridPane.columnIndex="1">

                                <Button text="☆" onAction="#rateOverall"/>
                                <Button text="☆" onAction="#rateOverall"/>
                                <Button text="☆" onAction="#rateOverall"/>
                                <Button text="☆" onAction="#rateOverall"/>
                                <Button text="☆" onAction="#rateOverall"/>
                            </HBox>

                            <!-- CLEANLINESS -->
                            <Label text="Cleanliness:"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <HBox fx:id="cleanlinessStars"
                                  spacing="5"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="1">

                                <Button text="☆" onAction="#rateCleanliness"/>
                                <Button text="☆" onAction="#rateCleanliness"/>
                                <Button text="☆" onAction="#rateCleanliness"/>
                                <Button text="☆" onAction="#rateCleanliness"/>
                                <Button text="☆" onAction="#rateCleanliness"/>
                            </HBox>

                            <!-- SERVICE -->
                            <Label text="Staff Service:"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <HBox fx:id="serviceStars"
                                  spacing="5"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1">

                                <Button text="☆" onAction="#rateService"/>
                                <Button text="☆" onAction="#rateService"/>
                                <Button text="☆" onAction="#rateService"/>
                                <Button text="☆" onAction="#rateService"/>
                                <Button text="☆" onAction="#rateService"/>

                            </HBox>

                            <!-- COMFORT -->
                            <Label text="Room Comfort:"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <HBox fx:id="comfortStars"
                                  spacing="5"
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="1">

                                <Button text="☆" onAction="#rateComfort"/>
                                <Button text="☆" onAction="#rateComfort"/>
                                <Button text="☆" onAction="#rateComfort"/>
                                <Button text="☆" onAction="#rateComfort"/>
                                <Button text="☆" onAction="#rateComfort"/>
                            </HBox>

                            <!-- VALUE -->
                            <Label text="Value For Money:"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="0"/>

                            <HBox fx:id="valueStars"
                                  spacing="5"
                                  GridPane.rowIndex="4"
                                  GridPane.columnIndex="1">

                                <Button text="☆" onAction="#rateValue"/>
                                <Button text="☆" onAction="#rateValue"/>
                                <Button text="☆" onAction="#rateValue"/>
                                <Button text="☆" onAction="#rateValue"/>
                                <Button text="☆" onAction="#rateValue"/>
                            </HBox>
                        </GridPane>

                        <Label text="Additional Comments"/>

                        <TextArea fx:id="feedbackArea"
                                  prefHeight="150"
                                  wrapText="true"
                                  promptText="Tell us about your stay..."/>

                        <Button text="Submit Feedback"
                                onAction="#submitFeedback"
                                maxWidth="200"
                                styleClass="button-primary"/>
                    </VBox>

                    <Button text="Back to Main Menu"
                            onAction="#handleBack"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
