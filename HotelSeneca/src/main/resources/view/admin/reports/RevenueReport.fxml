<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.admin.reports.RevenueReportController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="View:" />
            <ComboBox fx:id="viewCombo" prefWidth="100.0" />
            <Label text="From:" />
            <DatePicker fx:id="fromDate" prefHeight="34.0" prefWidth="140.0" />
            <Label text="To:" />
            <DatePicker fx:id="toDate" prefHeight="34.0" prefWidth="140.0" />
            <Label text="Room Type:" />
            <ComboBox fx:id="roomTypeCombo" prefWidth="110.0" />
            <Button fx:id="generateBtn" onAction="#onGenerate" styleClass="button-primary" text="Generate" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="exportCsvBtn" onAction="#onExportCsv" styleClass="button-secondary" text="Export CSV" />
            <Button fx:id="exportPdfBtn" onAction="#onExportPdf" styleClass="button-secondary" text="Export PDF" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="revenueTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colPeriod" prefWidth="140.0" text="Period" />
            <TableColumn fx:id="colCount" prefWidth="130.0" text="Reservations" />
            <TableColumn fx:id="colSubtotal" prefWidth="130.0" text="Subtotal" />
            <TableColumn fx:id="colTax" prefWidth="120.0" text="Tax" />
            <TableColumn fx:id="colDiscounts" prefWidth="130.0" text="Discounts" />
            <TableColumn fx:id="colTotal" prefWidth="130.0" text="Total" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="8.0" left="16.0" right="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="grandTotalLabel" styleClass="section-label" text="Grand Total: $0.00" />
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="4.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
