<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../../theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.admin.reports.ActivityLogReportController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="From:" />
            <DatePicker fx:id="fromDate" prefWidth="140.0" />
            <Label prefHeight="16.0" prefWidth="35.0" text="To:" />
            <DatePicker fx:id="toDate" prefWidth="140.0" />
            <Region prefHeight="26.0" prefWidth="17.0" />
            <Button fx:id="filterBtn" onAction="#onFilter" styleClass="button-primary" text="Filter" />
            <Region prefHeight="26.0" prefWidth="47.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="exportCsvBtn" onAction="#onExportCsv" styleClass="button-secondary" text="Export CSV" />
            <Button fx:id="exportTxtBtn" onAction="#onExportTxt" styleClass="button-secondary" text="Export TXT" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="logTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colTimestamp" prefWidth="170.0" text="Timestamp" />
            <TableColumn fx:id="colActor" prefWidth="110.0" text="Actor" />
            <TableColumn fx:id="colAction" prefWidth="120.0" text="Action" />
            <TableColumn fx:id="colEntityType" prefWidth="120.0" text="Entity Type" />
            <TableColumn fx:id="colEntityId" prefWidth="106.48052978515625" text="Entity ID" />
            <TableColumn fx:id="colMessage" prefWidth="333.51934814453125" text="Message" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="14.0" left="16.0" right="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="statusLabel" styleClass="section-label" />
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="4.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
