<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.admin.PaymentDialogController">
    <top>
        <VBox prefWidth="870.0" spacing="10">
            <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label styleClass="title-label" text="PAYMENT" />
                </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="Search:" />
                <TextField fx:id="guestSearchField" alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="280.0" onAction="#handleGuestSearch" promptText="Guest name, email, or reservation #" />
                <Button minHeight="30.0" prefHeight="30.0" maxHeight="30.0" onAction="#handleGuestSearch" text="Search" />
                <ComboBox fx:id="reservationResultsCombo" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="430.0" promptText="Select a matching reservation" />
            </HBox>
            <HBox alignment="CENTER_LEFT" prefWidth="838.0" spacing="10">
                <Label alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="Reservation #:" />
                <TextField fx:id="reservationIdField" alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="90.0" onAction="#handleViewPaymentHistory" promptText="e.g. 12" />
                <Label alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="112.0" text="Payment Amount:">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="amountField" alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="180.0" promptText="Amount, negative for refund" />
                <ComboBox fx:id="methodCombo" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="160.0" promptText="Payment Method" />
                <Button onAction="#handleAddPayment" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" styleClass="button-success" text="Record Payment" />
            </HBox>
            <Label fx:id="statusLabel" styleClass="muted-label" />
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets bottom="16" left="16" right="16" top="10" /></padding>

            <Separator />

            <Label styleClass="section-label" text="Payment History" />
            <TableView fx:id="paymentHistoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateCol" prefWidth="241.0" text="Date">
                        <cellValueFactory>
                            <PropertyValueFactory property="date" />
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="amountCol" prefWidth="340.0" text="Amount">
                        <cellValueFactory>
                            <PropertyValueFactory property="amount" />
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="methodCol" minWidth="0.0" prefWidth="256.0" text="Method">
                        <cellValueFactory>
                            <PropertyValueFactory property="paymentMethod" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
