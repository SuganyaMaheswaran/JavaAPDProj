<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.admin.BookingViewController">
    <top>
        <VBox spacing="10">
            <!-- Single toolbar row: filters and the primary create action live together,
                 wrapping to a new line (instead of clipping) once the window gets too
                 narrow to fit everything; each label stays paired with its control. -->
            <FlowPane hgap="10.0" vgap="8.0" alignment="CENTER_LEFT">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <Label alignment="CENTER" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="From:">
                                <font><Font name="Arial" size="13.0" /></font>
                            </Label>
                            <DatePicker fx:id="dateStartPicker" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="120.0" />
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <Label alignment="CENTER" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="To:">
                                <font><Font name="Arial" size="13.0" /></font>
                            </Label>
                            <DatePicker fx:id="dateEndPicker" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="120.0" />
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <Label alignment="CENTER" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="Guest:">
                                <font><Font name="Arial" size="13.0" /></font>
                            </Label>
                            <TextField fx:id="searchField" alignment="CENTER_LEFT" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="180.0" promptText="Name or phone" />
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <Label alignment="CENTER" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" text="Status:">
                                <font><Font name="Arial" size="13.0" /></font>
                            </Label>
                            <ComboBox fx:id="statusComboBox" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" prefWidth="120.0" />
                        </children>
                    </HBox>

                    <Button fx:id="searchBtn" alignment="CENTER" contentDisplay="CENTER" minHeight="30.0" onAction="#handleSearch" text="Search">
                        <font>
                            <Font name="Arial" size="13.0" />
                        </font>
                    </Button>

                    <Button fx:id="clearFiltersBtn" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" minWidth="30.0" prefWidth="30.0" maxWidth="30.0" onAction="#handleClearFilters" styleClass="button-secondary">
                        <graphic><FontIcon iconLiteral="mdi2f-filter-off" iconSize="16" /></graphic>
                        <tooltip><Tooltip text="Clear All Filters" /></tooltip>
                    </Button>

                    <Region prefWidth="20.0" />

                    <Button fx:id="newReservationBtn" mnemonicParsing="false" alignment="CENTER" contentDisplay="CENTER" minHeight="30.0" prefHeight="30.0" maxHeight="30.0" onAction="#handleNewReservation" styleClass="button-primary" text="New Reservation">
                        <font><Font name="Arial Bold" size="13.0" /></font>
                    </Button>
                </children>

                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
                </padding>
            </FlowPane>

        </VBox>
    </top>
    <center>
        <TableView fx:id="reservationTable" BorderPane.alignment="CENTER">
            <columns>
                <!-- Setting -fx-alignment on a TableColumn only aligns its body cells;
                     JavaFX does not mirror that onto the header label, so each header's
                     text is set via an explicitly-aligned graphic Label instead, matching
                     its column's cell alignment exactly. -->
                <TableColumn fx:id="idColumn" prefWidth="50.0" style="-fx-alignment: CENTER-RIGHT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_RIGHT" text="ID" /></graphic>
                </TableColumn>
                <TableColumn fx:id="guestColumn" prefWidth="120.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Name" /></graphic>
                </TableColumn>
                <TableColumn fx:id="phoneColumn" prefWidth="100.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Phone" /></graphic>
                </TableColumn>
                <TableColumn fx:id="roomColumn" prefWidth="80.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Room #" /></graphic>
                </TableColumn>
                <TableColumn fx:id="checkInColumn" prefWidth="100.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Check in" /></graphic>
                </TableColumn>
                <TableColumn fx:id="checkOutColumn" prefWidth="100.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Check out" /></graphic>
                </TableColumn>
                <TableColumn fx:id="guestsColumn" prefWidth="80.0" style="-fx-alignment: CENTER-RIGHT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_RIGHT" text="# of Guests" /></graphic>
                </TableColumn>
                <TableColumn fx:id="paymentColumn" prefWidth="100.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Payment" /></graphic>
                </TableColumn>
                <TableColumn fx:id="statusColumn" prefWidth="90.0" style="-fx-alignment: CENTER-LEFT;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER_LEFT" text="Status" /></graphic>
                </TableColumn>
                <TableColumn fx:id="actionsColumn" prefWidth="230.0" minWidth="230.0" sortable="false" style="-fx-alignment: CENTER;">
                    <graphic><Label maxWidth="Infinity" alignment="CENTER" text="Actions" /></graphic>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <BorderPane.margin>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
