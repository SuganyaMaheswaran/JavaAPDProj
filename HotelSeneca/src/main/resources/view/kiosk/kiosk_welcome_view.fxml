<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1000.0" styleClass="kiosk-shell" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.kiosk.KioskWelcomeController" stylesheets="@../theme.css">
   <top>
      <VBox styleClass="kiosk-hero" spacing="22.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <StackPane styleClass="kiosk-logo-badge">
                     <Label text="🏨" />
                  </StackPane>
                  <VBox spacing="2.0">
                     <Label text="SENECA HOTEL" styleClass="kiosk-hero-eyebrow" />
                     <Label text="Self-Service Reservation Kiosk" styleClass="kiosk-hero-subtitle" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <StackPane styleClass="kiosk-icon-fab">
                     <Label text="🔔" />
                  </StackPane>
               </children>
            </HBox>
            <VBox spacing="8.0">
               <children>
                  <Label text="Book your room in minutes" styleClass="kiosk-hero-title" wrapText="true" />
                  <Label maxWidth="580.0" text="Follow six quick steps to reserve your stay. Billing is completed at the front desk after your reservation is confirmed." styleClass="kiosk-hero-subtitle" wrapText="true" />
               </children>
            </VBox>
            <FlowPane hgap="10.0" vgap="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="1" styleClass="kiosk-step-chip-index" />
                        <Label text="Guests" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="2" styleClass="kiosk-step-chip-index" />
                        <Label text="Dates" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="3" styleClass="kiosk-step-chip-index" />
                        <Label text="Rooms" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="4" styleClass="kiosk-step-chip-index" />
                        <Label text="Add-ons" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="5" styleClass="kiosk-step-chip-index" />
                        <Label text="Details" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="kiosk-step-chip">
                     <children>
                        <Label text="6" styleClass="kiosk-step-chip-index" />
                        <Label text="Confirm" styleClass="kiosk-step-chip-label" />
                     </children>
                  </HBox>
               </children>
            </FlowPane>
         </children>
      </VBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" maxWidth="600.0" prefWidth="600.0" spacing="16.0" styleClass="kiosk-floating-panel">
               <children>
                  <Label text="Ready to check in?" styleClass="kiosk-page-title" />
                  <Label maxWidth="440.0" text="Tap Start Booking to begin -- we'll walk you through guests, dates, rooms, add-ons and your details." styleClass="kiosk-page-subtitle" textAlignment="CENTER" wrapText="true" />
                  <Button mnemonicParsing="false" onAction="#handleStartBooking" styleClass="kiosk-btn-primary" text="Start Booking   →">
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
