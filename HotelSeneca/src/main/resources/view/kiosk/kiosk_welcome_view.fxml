                  <Button mnemonicParsing="false" onAction="#showRules" styleClass="kiosk-btn-ghost" text="Rules &amp; Regulations" />
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets top="-46.0" />
         </BorderPane.margin>
      </VBox>
