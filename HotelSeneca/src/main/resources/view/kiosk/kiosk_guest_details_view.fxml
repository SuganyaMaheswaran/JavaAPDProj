<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="kiosk-shell" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.seneca.hotel.controller.kiosk.KioskGuestDetailsController" stylesheets="@../theme.css">

    <left>
        <VBox prefWidth="190.0" spacing="8.0" styleClass="kiosk-sidebar">
            <padding><Insets bottom="22" left="16" right="16" top="22" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <StackPane styleClass="kiosk-logo-badge">
                            <Label text="🏨" />
                        </StackPane>
                        <VBox spacing="1.0">
                            <Label text="SENECA" styleClass="kiosk-sidebar-title" />
                            <Label text="HOTEL" styleClass="kiosk-sidebar-subtitle" />
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="14.0" /></VBox.margin>
                </HBox>
                <Button maxWidth="Infinity" onAction="#showRules" text="📋   Rules &amp; Regulations" styleClass="kiosk-nav-button" />
                <Button maxWidth="Infinity" onAction="#showRoomPolicy" text="🛎   Room Booking Policy" styleClass="kiosk-nav-button" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="false" fitToWidth="true" styleClass="kiosk-scroll" BorderPane.alignment="CENTER">
        <content>
        <VBox alignment="TOP_CENTER" spacing="14.0">
            <padding><Insets bottom="16" left="50" right="50" top="18" /></padding>
            <HBox alignment="CENTER" styleClass="kiosk-tabbar">
                <Label text="Guests" styleClass="kiosk-tab, kiosk-tab-completed" />
                <Label text="Dates" styleClass="kiosk-tab, kiosk-tab-completed" />
                <Label text="Rooms" styleClass="kiosk-tab, kiosk-tab-completed" />
                <Label text="Add-ons" styleClass="kiosk-tab, kiosk-tab-completed" />
                <Label text="Details" styleClass="kiosk-tab, kiosk-tab-active" />
                <Label text="Confirm" styleClass="kiosk-tab" />
            </HBox>
            <VBox alignment="TOP_CENTER" spacing="16.0" styleClass="kiosk-step-card" maxWidth="900.0" prefWidth="900.0">
                <Label text="Tell us about the lead guest" styleClass="kiosk-page-title" />
                <Label text="We'll use these details for your reservation and confirmation." styleClass="kiosk-page-subtitle" />

                <HBox spacing="20.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="FIRST NAME *" styleClass="kiosk-field-label" />
                            <TextField fx:id="firstNameField" promptText="Please input your first name" />
                        </VBox>
                        <Label fx:id="firstNameMsgLabel" styleClass="label-success" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="LAST NAME *" styleClass="kiosk-field-label" />
                            <TextField fx:id="lastNameField" promptText="Please input your last name" />
                        </VBox>
                        <Label fx:id="lastNameMsgLabel" styleClass="label-danger" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="PHONE *" styleClass="kiosk-field-label" />
                            <TextField fx:id="phoneField" promptText="(000)-000-0000" />
                        </VBox>
                        <Label fx:id="phoneMsgLabel" styleClass="label-danger" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="EMAIL *" styleClass="kiosk-field-label" />
                            <TextField fx:id="emailField" promptText="you@example.com" />
                        </VBox>
                        <Label fx:id="emailMsgLabel" styleClass="label-danger" />
                    </VBox>
                </HBox>

                <VBox spacing="4.0">
                    <VBox spacing="2.0" styleClass="kiosk-field-pill">
                        <Label text="STREET ADDRESS *" styleClass="kiosk-field-label" />
                        <TextField fx:id="addressField" promptText="Street, unit" />
                    </VBox>
                    <Label fx:id="addressMsgLabel" styleClass="label-danger" />
                </VBox>

                <HBox spacing="20.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="CITY *" styleClass="kiosk-field-label" />
                            <TextField fx:id="cityField" promptText="City" />
                        </VBox>
                        <Label fx:id="cityMsgLabel" styleClass="label-success" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="2.0" styleClass="kiosk-field-pill">
                            <Label text="POSTAL CODE *" styleClass="kiosk-field-label" />
                            <TextField fx:id="postalCodeField" promptText="M1A 2B3" />
                        </VBox>
                        <Label fx:id="postalCodeMsgLabel" styleClass="label-success" />
                    </VBox>
                </HBox>

                <VBox spacing="8.0" styleClass="kiosk-panel-card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Loyalty program" style="-fx-font-weight: 800; -fx-font-size: 13px;" />
                        <Hyperlink fx:id="benefitsLink" text="View loyalty benefits" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Already a member? Check your loyalty points:" />
                        <Button fx:id="checkMemberButton" onAction="#handleCheckMember" text="Check" styleClass="kiosk-btn-ghost" />
                    </HBox>
                    <Label fx:id="memberStatusLabel" styleClass="label-success" wrapText="true" />
                    <CheckBox fx:id="enrollCheck" text="I'm not a member yet, enroll me using the details above" />
                </VBox>
            </VBox>
        </VBox>
        </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="kiosk-price-bar">
            <VBox>
                <Label text="STEP 5 OF 6" styleClass="kiosk-price-caption" />
                <Label text="Details" styleClass="kiosk-page-title" style="-fx-font-size: 15px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backButton" text="Back" onAction="#handleBack" styleClass="kiosk-btn-ghost" />
            <Button fx:id="confirmButton" text="Review &amp; Confirm   →" onAction="#handleReviewAndConfirm" styleClass="kiosk-btn-primary" />
        </HBox>
    </bottom>
</BorderPane>
